# En desarrollo local, Vite redirige /api al backend definido en vite.config.ts.
VITE_API_BASE_URL=/api

# En producción, configurar esta variable como Build Variable de Coolify.
# Vite la incorpora al bundle; no se necesita API_UPSTREAM en runtime para Nginx.
# VITE_API_BASE_URL=https://mapi.sgdm.lavalleja.uy
